# Spotify App Credentials
# Obtén estas credenciales en el Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=tu_spotify_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_spotify_client_secret_aqui

# URL de redirección configurada en Spotify Developer Dashboard y en tu servidor backend.
# Para pruebas locales, usaremos http://localhost:8000/callback
SPOTIFY_REDIRECT_URI=http://localhost:8000/callback

# Configuración del servidor backend
PORT=8000
HOST=127.0.0.1

# Google AI Studio API Key (Obtenla gratis en: https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

